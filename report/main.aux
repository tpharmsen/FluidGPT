\@writefile{toc}{\contentsline {paragraph}{Enstrophy spectrum.}{45}{section*.61}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces Scaled enstrophy spectrum error ratio $\epsilon _Z$ per wavenumber for \texttt  {FM-d2} and \texttt  {AR-d2} on the \textit  {amira} dataset, evaluated at $t=20$ and $t=200$ of the 200-step rollout. As for the energy spectrum, the flow matching samples achieve consistently lower error than the deterministic baseline, indicating more accurate reproduction of the flow's rotational energy content.}}{46}{figure.caption.62}\protected@file@percent }
\newlabel{fig:enstrophyspectrum_amira}{{7.7}{46}{Scaled enstrophy spectrum error ratio $\epsilon _Z$ per wavenumber for \texttt {FM-d2} and \texttt {AR-d2} on the \textit {amira} dataset, evaluated at $t=20$ and $t=200$ of the 200-step rollout. As for the energy spectrum, the flow matching samples achieve consistently lower error than the deterministic baseline, indicating more accurate reproduction of the flow's rotational energy content}{figure.caption.62}{}}
