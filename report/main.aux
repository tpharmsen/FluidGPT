\@writefile{toc}{\contentsline {section}{\numberline {7.3}Rollout prediction}{42}{section.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces 3x3 subplot of the relative absolute error of rollout predictions for all models, grouped per dataset. The models are used in autoregressive fashion to predict the full-length trajectory, starting with the first available input timeblock containing the initialization conditions. The flow matching models take 16 global rollout samples for each trajectory in the zero-shot validation dataset, drawing a new prior distribution sample for each individual input-output prediction during the autoregressive rollout. The flow matching model \texttt  {FM-d2} outperforms all other models except on \texttt  {pdegym-sines}. Error accumulation patterns differ across datasets and models.}}{42}{figure.caption.50}\protected@file@percent }
\newlabel{fig:rollout}{{7.3}{42}{3x3 subplot of the relative absolute error of rollout predictions for all models, grouped per dataset. The models are used in autoregressive fashion to predict the full-length trajectory, starting with the first available input timeblock containing the initialization conditions. The flow matching models take 16 global rollout samples for each trajectory in the zero-shot validation dataset, drawing a new prior distribution sample for each individual input-output prediction during the autoregressive rollout. The flow matching model \texttt {FM-d2} outperforms all other models except on \texttt {pdegym-sines}. Error accumulation patterns differ across datasets and models}{figure.caption.50}{}}
\@writefile{toc}{\contentsline {paragraph}{Error accumulation rate.}{42}{section*.51}\protected@file@percent }
