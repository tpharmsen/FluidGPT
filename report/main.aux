\newlabel{se:spectraresults}{{7.4}{43}{Spectrum analysis}{section.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt  {FM-d2} and \texttt  {AR-d2} on the \textit  {amira} dataset, evaluated at $t=20$ and $t=200$ of the 200-step rollout. The flow matching median (solid line) and IQR (shaded band) across 16 samples lie well below the deterministic baseline at both timesteps, reflecting more accurate spectral energy content.}}{44}{figure.caption.55}\protected@file@percent }
\newlabel{fig:energyspectrum_amira}{{7.4}{44}{Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt {FM-d2} and \texttt {AR-d2} on the \textit {amira} dataset, evaluated at $t=20$ and $t=200$ of the 200-step rollout. The flow matching median (solid line) and IQR (shaded band) across 16 samples lie well below the deterministic baseline at both timesteps, reflecting more accurate spectral energy content}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt  {FM-d2} and \texttt  {AR-d2} on the \textit  {pdegym-sines} dataset, evaluated at $t=5$ and $t=20$ of the 21-step rollout. Unlike the other datasets, \texttt  {AR-d2} matches or locally outperforms \texttt  {FM-d2} over part of the wavenumber range, consistent with its relatively stronger overall performance on this dataset.}}{44}{figure.caption.56}\protected@file@percent }
\newlabel{fig:energyspectrum_sines}{{7.5}{44}{Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt {FM-d2} and \texttt {AR-d2} on the \textit {pdegym-sines} dataset, evaluated at $t=5$ and $t=20$ of the 21-step rollout. Unlike the other datasets, \texttt {AR-d2} matches or locally outperforms \texttt {FM-d2} over part of the wavenumber range, consistent with its relatively stronger overall performance on this dataset}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt  {FM-d2} and \texttt  {AR-d2} on the \textit  {pdegym-bb} dataset, evaluated at $t=5$ and $t=20$ of the 21-step rollout. As with \textit  {amira}, the flow matching samples show consistently lower error than the deterministic baseline across the resolved wavenumber range.}}{45}{figure.caption.57}\protected@file@percent }
\newlabel{fig:energyspectrum_bb}{{7.6}{45}{Scaled energy spectrum error ratio $\epsilon _E$ per wavenumber for \texttt {FM-d2} and \texttt {AR-d2} on the \textit {pdegym-bb} dataset, evaluated at $t=5$ and $t=20$ of the 21-step rollout. As with \textit {amira}, the flow matching samples show consistently lower error than the deterministic baseline across the resolved wavenumber range}{figure.caption.57}{}}
\@writefile{toc}{\contentsline {paragraph}{Spectral ranges and overall fidelity.}{45}{section*.58}\protected@file@percent }
