\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Ground-truth and predicted trajectory for the validation \texttt  {pdebench-comp} dataset. The first row shows the ground-truth trajectory, while the second to fifth row shows the predicted trajectory for each of the four surrogate foundation models.}}{40}{figure.caption.44}\protected@file@percent }
\newlabel{fig:preds}{{7.1}{40}{Ground-truth and predicted trajectory for the validation \texttt {pdebench-comp} dataset. The first row shows the ground-truth trajectory, while the second to fifth row shows the predicted trajectory for each of the four surrogate foundation models}{figure.caption.44}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.2}Single-step prediction}{41}{section.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Boxplot of the relative absolute error of the single next-timeblock prediction for each of the four surrogate foundation models, grouped by dataset. The models are trained on the same trajectory data split and evaluated in zero-shot fashion on the validation dataset. For the flow matching models, FM-d2 and FM-d3, 16 samples are taken for each input-output pair. The flow matching model FM-d2 mostly outperforms the other models, except on the pdebench-incomp and pdegym-sines datasets. All models struggle to predict the more complex pdebench-comp dataset.}}{41}{figure.caption.45}\protected@file@percent }
\newlabel{fig:ssbox}{{7.2}{41}{Boxplot of the relative absolute error of the single next-timeblock prediction for each of the four surrogate foundation models, grouped by dataset. The models are trained on the same trajectory data split and evaluated in zero-shot fashion on the validation dataset. For the flow matching models, FM-d2 and FM-d3, 16 samples are taken for each input-output pair. The flow matching model FM-d2 mostly outperforms the other models, except on the pdebench-incomp and pdegym-sines datasets. All models struggle to predict the more complex pdebench-comp dataset}{figure.caption.45}{}}
\@writefile{toc}{\contentsline {paragraph}{Probabilistic vs.\ deterministic models.}{41}{section*.46}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Effect of dataset complexity.}{41}{section*.47}\protected@file@percent }
